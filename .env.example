# Google Gemini API Key (Opcional para modo online - obtenha gratuitamente no Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Hyperparâmetros de Recuperação
DENSE_TOP_K=10
SPARSE_TOP_K=10
FINAL_TOP_K=5
RRF_K=60

# Modelos padrão
DEFAULT_LLM_MODEL=gemini-2.5-flash
DEFAULT_EMBEDDING_MODEL=text-embedding-004
